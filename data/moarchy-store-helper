#!/usr/bin/python3
"""Privileged half of moarchy-store. Runs as root via pkexec.

The whole point of this file is that the polkit action does NOT point at
pacman. If it did, any user who could authenticate once could install any
package -- including one with a setuid binary or an install hook -- which is a
straightforward local privilege escalation.

Instead the action points here, and this refuses to touch anything that is not
named in the shipped catalogue. Adding an installable app therefore means
editing a root-owned file, which is a reviewable act rather than a runtime
decision.

Usage:  moarchy-store-helper install|remove PKG
"""

from __future__ import annotations

import os
import re
import sys
import tomllib
from pathlib import Path

CATALOGUE = Path("/usr/share/moarchy-store/catalogue.toml")

# Arch package names: alphanumeric plus @ . _ + -, not starting with a dash.
# Validated before the name is ever used, so a name like "-Sy" or "a b" cannot
# turn into extra pacman arguments.
PKGNAME = re.compile(r"^[a-z0-9][a-z0-9@._+-]*$")


def fail(msg: str, code: int = 1) -> None:
    print(f"moarchy-store-helper: {msg}", file=sys.stderr)
    raise SystemExit(code)


def allowlist() -> set[str]:
    if not CATALOGUE.is_file():
        fail(f"catalogue missing at {CATALOGUE}")

    # If the catalogue is writable by anyone but root, the allowlist is
    # meaningless -- an attacker would just add their package to it first.
    st = CATALOGUE.stat()
    if st.st_uid != 0:
        fail(f"{CATALOGUE} is not owned by root; refusing")
    if st.st_mode & 0o022:
        fail(f"{CATALOGUE} is group- or world-writable; refusing")

    with CATALOGUE.open("rb") as fh:
        data = tomllib.load(fh)
    return {
        entry["pkg"]
        for entry in data.get("app", [])
        if isinstance(entry, dict) and "pkg" in entry
    }


def main() -> None:
    if len(sys.argv) != 3:
        fail("usage: moarchy-store-helper install|remove PKG", 2)

    action, pkg = sys.argv[1], sys.argv[2]

    if action not in ("install", "remove"):
        fail(f"unknown action {action!r}", 2)
    if not PKGNAME.match(pkg):
        fail(f"invalid package name {pkg!r}", 2)

    allowed = allowlist()
    if pkg not in allowed:
        fail(f"{pkg!r} is not in the moarchy-store catalogue; refusing")

    if action == "install":
        argv = ["/usr/bin/pacman", "-S", "--needed", "--noconfirm", "--", pkg]
    else:
        # -R, not -Rns: cascading removal of shared dependencies is not
        # something to do unattended on someone's phone.
        argv = ["/usr/bin/pacman", "-R", "--noconfirm", "--", pkg]

    # A predictable environment: pkexec already scrubs most of it, but pacman
    # reads a few of these and inheriting them from the caller is needless.
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/bin",
        "LANG": "C.UTF-8",
        "HOME": "/root",
    }
    os.execve(argv[0], argv, env)


if __name__ == "__main__":
    main()
