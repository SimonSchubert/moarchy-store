#!/usr/bin/python3
"""Privileged half of moarchy-store. Runs as root via pkexec.

The whole point of this file is that the polkit action does NOT point at
pacman. If it did, any user who could authenticate once could install any
package -- including one with a setuid binary or an install hook -- which is a
straightforward local privilege escalation.

Instead the action points here, and this refuses to touch anything that is not
in an allowlist it has established for itself:

  * the catalogue shipped with the package, which is root-owned; and
  * a remotely published catalogue, but only if `gpgv` says it carries a good
    signature from a key in the shipped keyring, and only if its serial is not
    older than the shipped one.

The remote catalogue lives in the calling user's cache and is therefore fully
under their control. That is fine: tampering with it only breaks the signature.
Nothing the unprivileged half says is taken on trust here -- it re-verifies.

Usage:  moarchy-store-helper install|remove PKG
"""

from __future__ import annotations

import os
import pwd
import re
import subprocess
import sys
import tomllib
from pathlib import Path

SHARE = Path("/usr/share/moarchy-store")
CATALOGUE = SHARE / "catalogue.toml"
KEYRING = SHARE / "catalogue-signing-key.gpg"

# Arch package names: alphanumeric plus @ . _ + -, not starting with a dash.
# Validated before the name is ever used, so a name like "-Sy" or "a b" cannot
# turn into extra pacman arguments.
PKGNAME = re.compile(r"^[a-z0-9][a-z0-9@._+-]*$")


def fail(msg: str, code: int = 1) -> None:
    print(f"moarchy-store-helper: {msg}", file=sys.stderr)
    raise SystemExit(code)


def _root_owned(path: Path) -> bool:
    """A file only counts as trusted input if root owns it and nobody else can
    write it -- otherwise the allowlist is whatever an attacker last wrote."""
    try:
        st = path.stat()
    except OSError:
        return False
    return st.st_uid == 0 and not st.st_mode & 0o022


def _packages(path: Path) -> set[str]:
    try:
        with path.open("rb") as fh:
            data = tomllib.load(fh)
    except (OSError, ValueError, tomllib.TOMLDecodeError):
        return set()
    # Only `source = "pacman"` entries, which is also every entry with no
    # source field at all. The catalogue additionally lists Omarchy shell
    # plugins, and those must never appear here: they install into the user's
    # own config directory with no privilege at all, so they never reach this
    # helper -- while a plugin id like "shell.settings" is a perfectly legal
    # pacman package name, and would silently widen an allowlist whose only job
    # is to stay narrow.
    return {
        entry["pkg"]
        for entry in data.get("app", [])
        if isinstance(entry, dict)
        and entry.get("source", "pacman") == "pacman"
        and isinstance(entry.get("pkg"), str)
    }


def _serial(path: Path) -> int:
    try:
        with path.open("rb") as fh:
            return int(tomllib.load(fh).get("serial", 0))
    except (OSError, ValueError, tomllib.TOMLDecodeError):
        return 0


def _caller_cache() -> Path | None:
    """Where the unprivileged half puts its downloads.

    pkexec sets PKEXEC_UID to the calling user. Resolving the home directory
    from the passwd database rather than $HOME matters: $HOME is inherited from
    a caller we do not trust, and would let anyone point this at a file of
    their choosing.
    """
    uid = os.environ.get("PKEXEC_UID")
    if not uid or not uid.isdigit():
        return None
    try:
        home = Path(pwd.getpwuid(int(uid)).pw_dir)
    except (KeyError, ValueError):
        return None
    return home / ".cache" / "moarchy-store"


def _remote_packages() -> set[str]:
    """Packages from the published catalogue, if it verifies."""
    cache = _caller_cache()
    if cache is None or not KEYRING.is_file() or not _root_owned(KEYRING):
        return set()

    catalogue, signature = cache / "catalogue.toml", cache / "catalogue.toml.sig"
    if not (catalogue.is_file() and signature.is_file()):
        return set()

    try:
        verified = subprocess.run(
            ["gpgv", "--keyring", str(KEYRING), str(signature), str(catalogue)],
            capture_output=True,
            timeout=30,
            check=False,
        ).returncode == 0
    except (subprocess.SubprocessError, OSError):
        return set()

    if not verified:
        return set()

    # A signature never expires, so without this an older signed catalogue
    # could be replayed to reinstate an entry that was deliberately removed.
    if _serial(catalogue) < _serial(CATALOGUE):
        return set()

    return _packages(catalogue)


def allowlist() -> set[str]:
    if not CATALOGUE.is_file():
        fail(f"catalogue missing at {CATALOGUE}")
    if not _root_owned(CATALOGUE):
        fail(f"{CATALOGUE} is not root-owned or is world-writable; refusing")

    return _packages(CATALOGUE) | _remote_packages()


def main() -> None:
    if len(sys.argv) != 3:
        fail("usage: moarchy-store-helper install|remove PKG", 2)

    action, pkg = sys.argv[1], sys.argv[2]

    if action not in ("install", "remove"):
        fail(f"unknown action {action!r}", 2)
    if not PKGNAME.match(pkg):
        fail(f"invalid package name {pkg!r}", 2)

    if pkg not in allowlist():
        fail(f"{pkg!r} is not in the moarchy-store catalogue; refusing")

    if action == "install":
        argv = ["/usr/bin/pacman", "-S", "--needed", "--noconfirm", "--", pkg]
    else:
        # -R, not -Rns: cascading removal of shared dependencies is not
        # something to do unattended on someone's phone.
        argv = ["/usr/bin/pacman", "-R", "--noconfirm", "--", pkg]

    # A predictable environment: pkexec already scrubs most of it, but pacman
    # reads a few of these and inheriting them from the caller is needless.
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/bin",
        "LANG": "C.UTF-8",
        "HOME": "/root",
    }
    os.execve(argv[0], argv, env)


if __name__ == "__main__":
    main()
